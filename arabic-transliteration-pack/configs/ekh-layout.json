{
  "name": "Arabic Transliteration - Academic",
  "description": "RAlt-based Arabic transliteration layout for External Keyboard Helper Pro. DIN 31635 / EI2 standard.",
  "version": "1.0.0",
  "author": "keybord_design",
  "modifier": "RIGHT_ALT",
  "mappings": [
    {"combo": "RAlt+a", "output": "ā", "unicode": "U+0101", "desc": "Long vowel alif"},
    {"combo": "RAlt+Shift+a", "output": "Ā", "unicode": "U+0100", "desc": "Capital long a"},
    {"combo": "RAlt+i", "output": "ī", "unicode": "U+012B", "desc": "Long vowel yāʾ"},
    {"combo": "RAlt+Shift+i", "output": "Ī", "unicode": "U+012A", "desc": "Capital long i"},
    {"combo": "RAlt+u", "output": "ū", "unicode": "U+016B", "desc": "Long vowel wāw"},
    {"combo": "RAlt+Shift+u", "output": "Ū", "unicode": "U+016A", "desc": "Capital long u"},
    {"combo": "RAlt+h", "output": "ḥ", "unicode": "U+1E25", "desc": "Ḥāʾ (ح)"},
    {"combo": "RAlt+Shift+h", "output": "Ḥ", "unicode": "U+1E24", "desc": "Capital ḥāʾ"},
    {"combo": "RAlt+s", "output": "ṣ", "unicode": "U+1E63", "desc": "Ṣād (ص)"},
    {"combo": "RAlt+Shift+s", "output": "Ṣ", "unicode": "U+1E62", "desc": "Capital ṣād"},
    {"combo": "RAlt+t", "output": "ṭ", "unicode": "U+1E6D", "desc": "Ṭāʾ (ط)"},
    {"combo": "RAlt+Shift+t", "output": "Ṭ", "unicode": "U+1E6C", "desc": "Capital ṭāʾ"},
    {"combo": "RAlt+d", "output": "ḍ", "unicode": "U+1E0D", "desc": "Ḍād (ض)"},
    {"combo": "RAlt+Shift+d", "output": "Ḍ", "unicode": "U+1E0C", "desc": "Capital ḍād"},
    {"combo": "RAlt+z", "output": "ẓ", "unicode": "U+1E93", "desc": "Ẓāʾ (ظ)"},
    {"combo": "RAlt+Shift+z", "output": "Ẓ", "unicode": "U+1E92", "desc": "Capital ẓāʾ"},
    {"combo": "RAlt+x", "output": "ḫ", "unicode": "U+1E2B", "desc": "Khāʾ (خ)"},
    {"combo": "RAlt+Shift+x", "output": "Ḫ", "unicode": "U+1E2A", "desc": "Capital khāʾ"},
    {"combo": "RAlt+g", "output": "ġ", "unicode": "U+0121", "desc": "Ghayn (غ)"},
    {"combo": "RAlt+Shift+g", "output": "Ġ", "unicode": "U+0120", "desc": "Capital ghayn"},
    {"combo": "RAlt+c", "output": "š", "unicode": "U+0161", "desc": "Shīn (ش)"},
    {"combo": "RAlt+Shift+c", "output": "Š", "unicode": "U+0160", "desc": "Capital shīn"},
    {"combo": "RAlt+v", "output": "ṯ", "unicode": "U+1E6F", "desc": "Thāʾ (ث)"},
    {"combo": "RAlt+Shift+v", "output": "Ṯ", "unicode": "U+1E6E", "desc": "Capital thāʾ"},
    {"combo": "RAlt+e", "output": "ḏ", "unicode": "U+1E0F", "desc": "Dhāl (ذ)"},
    {"combo": "RAlt+Shift+e", "output": "Ḏ", "unicode": "U+1E0E", "desc": "Capital dhāl"},
    {"combo": "RAlt+[", "output": "ʿ", "unicode": "U+02BF", "desc": "ʿAyn (ع)"},
    {"combo": "RAlt+]", "output": "ʾ", "unicode": "U+02BE", "desc": "Hamza (ء)"}
  ]
}
